<Window x:Class="QeliWin.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:QeliWin"
        Title="{l:Loc Profile}" Width="720" Height="680"
        MinWidth="540" MinHeight="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" FontFamily="{DynamicResource UiFont}">
    <Window.Resources>
        <Style TargetType="StackPanel" x:Key="Field">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HeaderText" Style="{StaticResource H1}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="OnManualEdit" ToolTip="{l:Loc EditIniHint}" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                        <Path Width="24" Height="24"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm2.92 2.33H4.5v-1.42l9.56-9.56 1.42 1.42-9.56 9.56zM20.71 7.04a.996.996 0 0 0 0-1.41l-2.34-2.34a.996.996 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                    </Viewbox>
                    <TextBlock Text="{l:Loc EditIni}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10">
            <ScrollViewer Style="{StaticResource SlimScrollViewer}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20">
                        <TextBlock Text="{l:Loc SectionAccess}" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="{l:Loc FieldName}" Style="{StaticResource Label}"/>
                            <TextBox x:Name="NameBox"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{l:Loc FieldServer}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="AddrBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Loc FieldPort}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="PortBox" Text="443"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="{l:Loc FieldMode}" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="ModeBox" SelectionChanged="OnModeChanged">
                                <ComboBoxItem Content="{l:Loc PresetFakeTls}" Tag="faketls"/>
                                <ComboBoxItem Content="{l:Loc PresetObfsWs}" Tag="obfs-ws"/>
                                <ComboBoxItem Content="{l:Loc PresetObfsNone}" Tag="obfs-none"/>
                                <ComboBoxItem Content="{l:Loc PresetUdp}" Tag="udp"/>
                                <ComboBoxItem Content="{l:Loc PresetUdpQuic}" Tag="udp-quic"/>
                                <ComboBoxItem Content="{l:Loc PresetUdpObfs}" Tag="udp-obfs"/>
                                <ComboBoxItem Content="{l:Loc PresetReality}" Tag="reality-tls"/>
                                <ComboBoxItem Content="{l:Loc PresetPlain}" Tag="plain"/>
                            </ComboBox>
                        </StackPanel>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{l:Loc FieldLogin}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="UserBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Loc FieldPassword}" Style="{StaticResource Label}"/>
                                <PasswordBox x:Name="PassBox"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{l:Loc ConnectionBehavior}" Style="{StaticResource SectionHeader}" Margin="0,12,0,14"/>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="{l:Loc FieldTimeout}" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="TimeoutBox" Width="160" HorizontalAlignment="Left" IsEditable="True">
                                <ComboBoxItem Content="15"/>
                                <ComboBoxItem Content="30"/>
                                <ComboBoxItem Content="60"/>
                                <ComboBoxItem Content="120"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="{l:Loc FieldRoamingPolicy}" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="RoamingPolicyBox">
                                <ComboBoxItem Content="{l:Loc RoamingAuto}" Tag="auto"/>
                                <ComboBoxItem Content="{l:Loc RoamingRequired}" Tag="required"/>
                                <ComboBoxItem Content="{l:Loc RoamingOff}" Tag="off"/>
                            </ComboBox>
                            <TextBlock Text="{l:Loc RoamingPolicyHint}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource FgDim}" FontSize="11.5" Margin="0,5,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="ReconnectBox" Content="{l:Loc ReconnectAutomatically}"
                                  Checked="OnReconnectChanged" Unchecked="OnReconnectChanged" Margin="0,0,0,12"/>
                        <StackPanel x:Name="ReconnectPanel" Margin="26,0,0,0">
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{l:Loc ReconnectRetries}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="ReconnectRetriesBox" Width="220" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="{l:Loc RetriesUnlimited}" Tag="-1"/>
                                    <ComboBoxItem Content="{l:Loc Retries3}" Tag="3"/>
                                    <ComboBoxItem Content="{l:Loc Retries5}" Tag="5"/>
                                    <ComboBoxItem Content="{l:Loc Retries10}" Tag="10"/>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Name="PersistTunBox" Content="{l:Loc PersistTun}"/>
                        </StackPanel>
                        <TextBlock Text="{l:Loc SectionTransport}" Style="{StaticResource SectionHeader}" Margin="0,28,0,14"/>
                        <StackPanel x:Name="SniPanel" Style="{StaticResource Field}">
                            <TextBlock Text="{l:Loc FieldSni}" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="SniBox" IsEditable="True" TextSearch.TextPath="Content">
                                <ComboBoxItem Content="www.microsoft.com"/>
                                <ComboBoxItem Content="www.cloudflare.com"/>
                                <ComboBoxItem Content="www.apple.com"/>
                                <ComboBoxItem Content="www.google.com"/>
                                <ComboBoxItem Content="www.amazon.com"/>
                            </ComboBox>
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{l:Loc FieldPadding}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="PaddingBox">
                                    <ComboBoxItem Content="{l:Loc Off}" Tag="off"/>
                                    <ComboBoxItem Content="{l:Loc PaddingStandard}" Tag="0,255"/>
                                    <ComboBoxItem Content="{l:Loc PaddingStrong}" Tag="40,400"/>
                                    <ComboBoxItem Content="{l:Loc PaddingMax}" Tag="100,800"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Loc FieldHeartbeat}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="HeartbeatBox">
                                    <ComboBoxItem Content="{l:Loc Off}" Tag="off"/>
                                    <ComboBoxItem Content="{l:Loc Hb15}" Tag="15000,2000"/>
                                    <ComboBoxItem Content="{l:Loc Hb30}" Tag="30000,5000"/>
                                    <ComboBoxItem Content="{l:Loc Hb60}" Tag="60000,8000"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="ObfsKeyPanel" Grid.Column="0">
                                <TextBlock Text="{l:Loc FieldObfsKey}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="ObfsKeyBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Loc FieldServerKey}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="KeyBox"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="RealityIdPanel" Style="{StaticResource Field}">
                            <TextBlock Text="{l:Loc FieldRealityId}" Style="{StaticResource Label}"/>
                            <TextBox x:Name="RealityIdBox"/>
                        </StackPanel>
                        <TextBlock Text="{l:Loc SectionNetwork}" Style="{StaticResource SectionHeader}" Margin="0,14,0,14"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{l:Loc FieldRouting}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="RoutingBox" SelectionChanged="OnRoutingChanged">
                                    <ComboBoxItem Content="{l:Loc RouteAll}" Tag="full-tunnel"/>
                                    <ComboBoxItem Content="{l:Loc RouteSplit}" Tag="split-tunnel"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Loc FieldMtu}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="MtuBox" IsEditable="True" TextSearch.TextPath="Content">
                                    <ComboBoxItem Content="0"/>
                                    <ComboBoxItem Content="1500"/>
                                    <ComboBoxItem Content="1400"/>
                                    <ComboBoxItem Content="1280"/>
                                    <ComboBoxItem Content="1200"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{l:Loc FieldIpv6Policy}" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="Ipv6PolicyBox">
                                <ComboBoxItem Content="{l:Loc Ipv6Auto}" Tag="auto"/>
                                <ComboBoxItem Content="{l:Loc Ipv6Required}" Tag="required"/>
                                <ComboBoxItem Content="{l:Loc Ipv6Off}" Tag="off"/>
                            </ComboBox>
                            <TextBlock Text="{l:Loc Ipv6PolicyHint}" TextWrapping="Wrap" Foreground="{DynamicResource FgDim}" FontSize="11.5" Margin="0,5,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="MtuProbeBox" Content="{l:Loc MtuProbe}" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{l:Loc FieldDnsMode}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="DnsModeBox" SelectionChanged="OnDnsModeChanged">
                                    <ComboBoxItem Content="{l:Loc DnsTunnel}" Tag="tunnel"/>
                                    <ComboBoxItem Content="{l:Loc DnsSystem}" Tag="system"/>
                                    <ComboBoxItem Content="{l:Loc DnsOff}" Tag="off"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="DnsServersPanel" Grid.Column="2">
                                <TextBlock Text="{l:Loc FieldDns}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="DnsBox" IsEditable="True" TextSearch.TextPath="Content">
                                    <ComboBoxItem Content="1.1.1.1, 8.8.8.8"/>
                                    <ComboBoxItem Content="1.1.1.1, 1.0.0.1"/>
                                    <ComboBoxItem Content="8.8.8.8, 8.8.4.4"/>
                                    <ComboBoxItem Content="9.9.9.9, 149.112.112.112"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{l:Loc DnsPushHint}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource FgDim}" FontSize="11.5" Margin="0,0,0,16"/>

                        <CheckBox x:Name="LocalBox" Content="{l:Loc RouteLocal}" Margin="0,0,0,12"/>
                        <CheckBox x:Name="KillSwitchBox" Content="{l:Loc KillSwitch}" Margin="0,0,0,18"/>
                        <StackPanel x:Name="FamilyLeakPanel" Margin="0,0,0,18">
                            <TextBlock Text="{l:Loc FamilyLeakHint}" TextWrapping="Wrap" Foreground="{DynamicResource FgDim}" FontSize="11.5" Margin="0,0,0,8"/>
                            <CheckBox x:Name="AllowIpv4LeakBox" Content="{l:Loc AllowIpv4Leak}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="AllowIpv6LeakBox" Content="{l:Loc AllowIpv6Leak}"/>
                        </StackPanel>

                        <TextBlock Text="{l:Loc SectionApplications}" Style="{StaticResource SectionHeader}" Margin="0,28,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{l:Loc FieldApps}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="AppsModeBox" SelectionChanged="OnAppsModeChanged">
                                    <ComboBoxItem Content="{l:Loc AppsAll}" Tag="all"/>
                                    <ComboBoxItem Content="{l:Loc AppsExclude}" Tag="exclude"/>
                                    <ComboBoxItem Content="{l:Loc AppsInclude}" Tag="include"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="10,20,0,0">
                                <Button x:Name="AppsPickBtn" Content="{l:Loc AppsPick}" Click="OnPickApps" MinWidth="150"/>
                                <TextBlock x:Name="AppsCountText" Style="{StaticResource Label}" Margin="0,4,0,0"
                                           HorizontalAlignment="Center" Opacity="0.75"/>
                            </StackPanel>
                        </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{l:Loc Cancel}" Click="OnCancel" MinWidth="104" Margin="0,0,10,0"/>
            <Button Content="{l:Loc Save}" Click="OnSave" Style="{StaticResource AccentButton}" MinWidth="130"/>
        </StackPanel>
    </Grid>
</Window>
