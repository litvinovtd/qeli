<Window x:Class="QeliWin.LicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:QeliWin"
        Title="{l:Loc Licenses}" Width="960" Height="640" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}"
        FontFamily="{DynamicResource UiFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="Summary" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="ResourcesList" SelectionChanged="OnSelected" HorizontalContentAlignment="Stretch"/>
            <TextBox x:Name="LicenseText" Grid.Column="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{l:Loc LicensesExport}" Click="OnExport" Margin="0,0,12,0"/>
            <Button Content="OK" Click="OnClose" MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
