<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Log lines must be greppable against the English error catalog in
         docs/*/manuals/TROUBLESHOOTING.md. Framework exception text is otherwise localized to the
         OS language, so a Russian Windows produced logs mixing qeli's own English strings
         with .NET messages like "Удаленный хост принудительно разорвал…" — unsearchable,
         and confusing when a user reports them. Shipping only the English resources keeps
         `e.Message` in one language. The app's OWN ru/en UI is unaffected: it uses the
         hand-written Loc table, not satellite assemblies. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- WPF self-contained single-file (the `standalone` artifact) must extract its
         bundled native DLLs (PresentationNative*, wpfgfx*, vcruntime140_cor3, ...) to
         disk at startup, otherwise WPF's P/Invokes can't resolve them and the app
         crashes immediately with System.DllNotFoundException in MS.Internal.WindowsBase
         (SetWindowLongPtrWndProc). Only affects single-file publish; harmless for the
         framework-dependent (`net-required`) build. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>QeliWin</AssemblyName>
    <RootNamespace>QeliWin</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\qeli.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Custom entry point: routes the service arg to the Windows Service host, else WPF. -->
    <StartupObject>QeliWin.Program</StartupObject>
    <Version>0.8.4</Version>
    <QeliNativeCorePath Condition="'$(QeliNativeCorePath)' == ''">$(MSBuildProjectDirectory)\native\qeli.dll</QeliNativeCorePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Platform-neutral production lifecycle/model adapters. Managed wire conformance
         is built separately by qeli-shared/QeliConformance. -->
    <ProjectReference Include="..\..\qeli-shared\QeliShared\QeliShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows Service host + ServiceController (install/start/stop). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
    <!-- QR generation for profile sharing (pure managed, PNG output).
         Version kept in lockstep with qeli-mac (R0 unification). -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- DPAPI (ProtectedData) encrypts the at-rest profile store under the current
         user's login secret (docs/*/archive/plans/RELEASE-FIXES.md E1) and is still used by
         Model/ProfileStore.cs + Service/ServiceState.cs. It needs NO PackageReference:
         net10.0-windows ships System.Security.Cryptography.ProtectedData in-box, so an
         explicit one is redundant and warned about as NU1510. -->
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is only used by TrayController (for NotifyIcon); keep its namespaces
         out of the global usings so they don't clash with WPF (Application, Button,
         TextBox, Brush, Color...). TrayController imports them explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- WireGuard's Wintun userspace TUN driver (amd64), embedded into the exe.
         Extracted to LocalAppData at startup and resolved via NativeLoader. -->
    <EmbeddedResource Include="wintun\wintun.dll">
      <LogicalName>wintun.dll</LogicalName>
    </EmbeddedResource>
    <!-- Original terms travel inside each EXE and remain readable/exportable via licenses. -->
    <EmbeddedResource Include="wintun\LICENSE.txt">
      <LogicalName>Qeli.Legal/drivers/Wintun-LICENSE.txt</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!-- WinDivert 2.2 packet capture pair used only by per-app profiles. The DLL expects
         the signed x64 driver beside it; NativeLoader extracts both into one protected
         directory before opening the filter. -->
    <EmbeddedResource Include="windivert\WinDivert.dll">
      <LogicalName>WinDivert.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="windivert\WinDivert64.sys">
      <LogicalName>WinDivert64.sys</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="windivert\LICENSE.txt">
      <LogicalName>Qeli.Legal/drivers/WinDivert-LICENSE.txt</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="windivert\NOTICE.txt">
      <LogicalName>Qeli.Legal/drivers/WinDivert-NOTICE.txt</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!-- Rust whole-client transport core (qeli.dll, configuration + transport ABI 1.16), cross-built for win-x64.
         It owns carrier/handshake/crypto/TCP/UDP/QUIC/Reality/bonding and the Wintun
         session/rings; C# retains only interface lifecycle, routes/DNS/trust and UI. -->
    <EmbeddedResource Include="$(QeliNativeCorePath)">
      <LogicalName>qeli.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- The common Cargo.lock superset travels with every published client. -->
    <EmbeddedResource Include="..\..\qeli\third-party-notices\rust\**\*">
      <LogicalName>Qeli.Legal/rust/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!-- Full reviewed NuGet graphs, runtime pack notices and embedded font licenses. -->
    <EmbeddedResource Include="..\..\qeli-shared\third-party-notices\dotnet\**\*">
      <LogicalName>Qeli.Legal/dotnet/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="..\LICENSE">
      <LogicalName>Qeli.Legal/Qeli-MPL-2.0.txt</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="RequireManagedLegalBundle" BeforeTargets="PrepareForBuild;ComputeFilesToPublish">
    <Error Condition="!Exists('..\..\qeli-shared\third-party-notices\dotnet\INDEX.tsv')" Text="Missing managed legal bundle; run scripts/managed_licenses.py and review its output." />
  </Target>
  <Target Name="RequireNativeLegalBundle" BeforeTargets="PrepareForBuild;ComputeFilesToPublish">
    <Error Condition="!Exists('..\..\qeli\third-party-notices\rust\INDEX.tsv')" Text="Missing native legal bundle; run scripts/native_licenses.py and review its output." />
  </Target>
</Project>
