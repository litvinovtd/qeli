    <Compile Include="../QeliWin/Vpn/PersistentWintunNetwork.cs" Link="Vpn/PersistentWintunNetwork.cs" />
    <Compile Include="../QeliWin/Vpn/ProcessAppMap.cs" Link="Vpn/ProcessAppMap.cs" />
    <Compile Include="../QeliWin/Vpn/RetainedDriverGates.cs" Link="Vpn/RetainedDriverGates.cs" />
    <Compile Include="../QeliWin/Vpn/TunnelIpv6Policy.cs" Link="Vpn/TunnelIpv6Policy.cs" />
    <Compile Include="../QeliWin/Vpn/VpnTunnel.cs" Link="Vpn/VpnTunnel.cs" />
    <Compile Include="../QeliWin/Vpn/WinDivertAdapter.cs" Link="Vpn/WinDivertAdapter.cs" />
    <Compile Include="../QeliWin/Vpn/WinDivertDestinationPolicy.cs" Link="Vpn/WinDivertDestinationPolicy.cs" />
    <Compile Include="../QeliWin/Vpn/WinDivertFlowTable.cs" Link="Vpn/WinDivertFlowTable.cs" />
    <Compile Include="../QeliWin/Vpn/WinDivertKillSwitchGate.cs" Link="Vpn/WinDivertKillSwitchGate.cs" />
    <Compile Include="../QeliWin/Vpn/WinDivertNative.cs" Link="Vpn/WinDivertNative.cs" />
    <Compile Include="../QeliWin/Vpn/WinDivertRuntime.cs" Link="Vpn/WinDivertRuntime.cs" />
    <Compile Include="../QeliWin/Vpn/WindowsAdapterModeGate.cs" Link="Vpn/WindowsAdapterModeGate.cs" />
    <Compile Include="../QeliWin/Vpn/WindowsAdapterPolicy.cs" Link="Vpn/WindowsAdapterPolicy.cs" />
    <Compile Include="../QeliWin/Vpn/WindowsRoamingSocket.cs" Link="Vpn/WindowsRoamingSocket.cs" />
    <Compile Include="../QeliWin/Vpn/Wintun.cs" Link="Vpn/Wintun.cs" />
    <Compile Include="../QeliWin/Service/ServiceHost.cs" Link="Service/ServiceHost.cs" />
    <Compile Include="../QeliWin/Service/ServiceManager.cs" Link="Service/ServiceManager.cs" />
    <Compile Include="../QeliWin/Service/ServiceMonotonicClock.cs" Link="Service/ServiceMonotonicClock.cs" />
    <Compile Include="../QeliWin/Service/ServiceObservation.cs" Link="Service/ServiceObservation.cs" />
