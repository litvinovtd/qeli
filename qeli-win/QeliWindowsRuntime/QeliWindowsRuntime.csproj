    <Compile Include="../QeliWin/Service/ServiceRegistration.cs" Link="Service/ServiceRegistration.cs" />
    <Compile Include="../QeliWin/Service/ServiceState.cs" Link="Service/ServiceState.cs" />
    <Compile Include="../QeliWin/Service/StorageLayout.cs" Link="Service/StorageLayout.cs" />
    <Compile Include="../QeliWin/Service/StorageMigration.cs" Link="Service/StorageMigration.cs" />
    <Compile Include="../QeliWin/Model/AppSettings.cs" Link="Model/AppSettings.cs" />
    <Compile Include="../QeliWin/Model/ProfileStore.cs" Link="Model/ProfileStore.cs" />
    <Compile Include="../QeliWin/Model/WindowDimensions.cs" Link="Model/WindowDimensions.cs" />
    <Compile Include="../QeliWin/WindowsCommand.cs" Link="WindowsCommand.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../QeliWin/wintun/wintun.dll">
      <LogicalName>wintun.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../QeliWin/windivert/WinDivert.dll">
      <LogicalName>WinDivert.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../QeliWin/windivert/WinDivert64.sys">
      <LogicalName>WinDivert64.sys</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(QeliNativeCorePath)">
      <LogicalName>qeli.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
