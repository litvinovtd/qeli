<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Explicit advisory source makes missing vulnerability data an audit error
       even when a developer uses a package mirror without VulnerabilityInfo. -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
