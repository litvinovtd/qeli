<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared, platform-neutral production adapter/model library for qeli-win and qeli-mac.
       The baseline is ABI 1.11; optional roaming bindings follow the additive ABI 1.14 contract.
       Managed wire codecs and their
       BouncyCastle dependency are compiled only by the sibling QeliConformance project.
       NO OS/UI dependencies: net10.0 (not -windows). -->
  <PropertyGroup>
    <!-- Log lines must be greppable against the English error catalog in
         docs/*/manuals/TROUBLESHOOTING.md. Framework exception text is otherwise localized to the
         OS language, so a Russian Windows produced logs mixing qeli's own English strings
         with .NET messages like "Удаленный хост принудительно разорвал…" — unsearchable,
         and confusing when a user reports them. Shipping only the English resources keeps
         `e.Message` in one language. The app's OWN ru/en UI is unaffected: it uses the
         hand-written Loc table, not satellite assemblies. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>QeliShared</AssemblyName>
    <RootNamespace>Qeli.Shared</RootNamespace>
    <Version>0.8.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Crypto\**\*.cs;Protocol\**\*.cs;Model\LinkConformance.cs" />
    <InternalsVisibleTo Include="QeliConformance" />
  </ItemGroup>

</Project>
