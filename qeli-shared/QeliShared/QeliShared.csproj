<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared, platform-neutral adapter/model library for qeli-win and qeli-mac.
       The active transport is the ABI 1.10 Rust core; this assembly owns lifecycle,
       platform plan dispatch and retained conformance/diagnostic fixtures. It contains
       no managed runtime transport fallback. NO OS/UI dependencies: net10.0 (not -windows). -->
  <PropertyGroup>
    <!-- Log lines must be greppable against the English error catalog in
         docs/*/TROUBLESHOOTING.md. Framework exception text is otherwise localized to the
         OS language, so a Russian Windows produced logs mixing qeli's own English strings
         with .NET messages like "Удаленный хост принудительно разорвал…" — unsearchable,
         and confusing when a user reports them. Shipping only the English resources keeps
         `e.Message` in one language. The app's OWN ru/en UI is unaffected: it uses the
         hand-written Loc table, not satellite assemblies. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>QeliShared</AssemblyName>
    <RootNamespace>Qeli.Shared</RootNamespace>
    <Version>0.7.15</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Retained cross-language wire/KAT and reachability diagnostics still exercise
         X25519, ChaCha20-Poly1305 and ChaCha20. Production transport uses Rust.
         Keep one BouncyCastle version for both desktop clients. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

</Project>
