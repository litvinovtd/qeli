<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>QeliConformance</AssemblyName>
    <RootNamespace>Qeli.Conformance</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QeliShared\QeliShared.csproj" />
    <Compile Include="..\QeliShared\Crypto\**\*.cs" Link="Crypto\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\QeliShared\Protocol\**\*.cs" Link="Protocol\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\QeliShared\Model\LinkConformance.cs" Link="Model\LinkConformance.cs" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <PropertyGroup>
    <QeliNativeCorePath Condition="'$(QeliNativeCorePath)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildProjectDirectory)/../../qeli-win/QeliWin/native/qeli.dll</QeliNativeCorePath>
    <QeliNativeCorePath Condition="'$(QeliNativeCorePath)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(MSBuildProjectDirectory)/../../qeli-mac/QeliMac/native/libqeli.dylib</QeliNativeCorePath>
  </PropertyGroup>
  <ItemGroup Condition="'$(QeliNativeCorePath)' != ''">
    <Content Include="$(QeliNativeCorePath)" Link="$([System.IO.Path]::GetFileName('$(QeliNativeCorePath)'))" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
