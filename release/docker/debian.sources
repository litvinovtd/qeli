# Reviewed snapshot; update together with the base image pins and qualification.
# HTTP bootstraps the slim image before ca-certificates is installed. APT verifies
# the signed Release metadata and package hashes using the Debian archive keyring.
Types: deb
URIs: http://snapshot.debian.org/archive/debian/20261008T000000Z
Suites: bookworm bookworm-updates
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
Check-Valid-Until: no

Types: deb
URIs: http://snapshot.debian.org/archive/debian-security/20261008T000000Z
Suites: bookworm-security
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
Check-Valid-Until: no
