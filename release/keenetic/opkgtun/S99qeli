#!/bin/sh
# /opt/etc/init.d/S99qeli — запуск qeli-client на Keenetic (Entware).
# ВАРИАНТ ДЛЯ OpkgTun (вебморда, KeeneticOS 5.0+): OPKGTUN=opkgtun0 задан ниже.
# Для обычного gateway-режима бери базовый ../S99qeli (или очисти OPKGTUN=).
# Управление: /opt/etc/init.d/S99qeli {start|stop|restart|status}
# ⚠️ ШАБЛОН: проверь LAN_IF под свою модель/прошивку (`ip a`). Детали — README.md рядом.

BIN=/opt/bin/qeli-client
CONF=/opt/etc/qeli/client.conf
PIDFILE=/opt/var/run/qeli-client.pid
LOG=/opt/var/log/qeli-client.log
TUN=vpn0            # имя tun (должно совпадать с dev= в конфиге; дефолт vpn0)
LAN_IF=br0          # LAN-бридж роутера (проверь `ip a` — бывает br0/bridge0)
GATEWAY=yes         # yes = самодельный NAT/forward (KeeneticOS ≤4.x или режим без OpkgTun)
SYSCTL_STATE=/opt/var/run/qeli-forwarding.state

# OpkgTun (KeeneticOS 5.0+): tun виден в вебморде и доступен в «Приоритетах подключений».
# Задай имя kernel-tun (напр. opkgtun0) И поставь в client.conf dev=opkgtun0 + dev_attach=true
# (на 5.0 opkgtun0 создаёт САМ ndm, qeli к нему прицепляется; без dev_attach ndm даёт
# `system failed [0xcffd00a9]`). Если задан — самодельный NAT/GATEWAY отключается:
# NAT/firewall/маршруты берёт на себя ndm, а регистрацию интерфейса делает хук
# /opt/etc/ndm/wan.d/010-qeli.sh (ndmc из init.d даёт 0xcffd0060).
OPKGTUN=opkgtun0    # пусто = выкл; opkgtun0 = включить нативный OpkgTun
OPKGTUN_STATE=/opt/var/run/qeli.opkgtun   # маркер-файл для wan.d-хука (имя интерфейса)
OPKGTUN_TUNIP=/opt/var/run/qeli.tunip     # qeli пишет сюда выданный сервером IP (для хука)
PLAN_STATE="$OPKGTUN_TUNIP"               # тот же подтверждённый NetworkPlan нужен legacy gateway
[ -n "$OPKGTUN" ] && TUN="$OPKGTUN"       # в OpkgTun-режиме tun = $OPKGTUN

# Персистентное состояние клиента на /opt (на роутере /var = tmpfs, теряется при ребуте).
#  * device-id: иначе сервер каждый раз видит «новое устройство» и тратит слот сессии.
#  * known_hosts: TOFU-пин статического ключа сервера (0.7.x). Без персистентности
#    каждый ребут = повторный TOFU → окно для MITM на первом коннекте. Не нужно, если
#    в конфиге задан реальный пиннингованный `key`.
export QELI_DEVICE_ID_FILE=/opt/etc/qeli/device-id
export QELI_KNOWN_HOSTS=/opt/etc/qeli/known_hosts
# qeli публикует файл только после успешного commit NetworkPlan. В OpkgTun его
# читает wan.d, в legacy gateway — init-скрипт для выбора реально согласованных семей.
export QELI_TUNIP_FILE="$PLAN_STATE"
export PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin

config_value() {
  awk -F= -v wanted="$1" '
    /^[[:space:]]*\[/ { section=$0; gsub(/[[:space:]]/, "", section); next }
    section == "[qeli]" {
      key=$1; gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
      if (key == wanted) {
        $1=""; sub(/^=/, ""); gsub(/^[[:space:]]+|[[:space:]]+$/, ""); print; exit
      }
    }
  ' "$CONF" 2>/dev/null
}

core_manages_gateway() {
  case "$(config_value gateway_nat):$(config_value forward)" in
    true:*|yes:*|1:*|*:true|*:yes|*:1) return 0 ;;
    *) return 1 ;;
  esac
}

legacy_ipv4_enabled() { grep -q '^ipv4=' "$PLAN_STATE" 2>/dev/null; }
legacy_ipv6_enabled() { grep -q '^ipv6=' "$PLAN_STATE" 2>/dev/null; }

legacy_gateway_preflight() {
  [ -n "$OPKGTUN" ] && return 0
  [ "$GATEWAY" = yes ] || return 0
  core_manages_gateway && return 0
  return 0
}

ipv6_wan_if() {
  ip -6 route show default 2>/dev/null | awk '
    { for (i=1; i<NF; i++) if ($i == "dev") { print $(i+1); exit } }
  '
}

save_forwarding_state() {
  [ -f "$SYSCTL_STATE" ] && return 0
  wan6="$(ipv6_wan_if)"
  case "$wan6" in *[!A-Za-z0-9_.:-]*) wan6="" ;; esac
  {
    echo "ipv4=$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)"
    echo "ipv6=$(cat /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null)"
    echo "wan6=$wan6"
    [ -z "$wan6" ] || echo "accept_ra6=$(cat "/proc/sys/net/ipv6/conf/$wan6/accept_ra" 2>/dev/null)"
  } > "$SYSCTL_STATE"
}

restore_forwarding_state() {
  [ -f "$SYSCTL_STATE" ] || return 0
  old4="$(sed -n 's/^ipv4=//p' "$SYSCTL_STATE" | head -n1)"
  old6="$(sed -n 's/^ipv6=//p' "$SYSCTL_STATE" | head -n1)"
  wan6="$(sed -n 's/^wan6=//p' "$SYSCTL_STATE" | head -n1)"
  oldra6="$(sed -n 's/^accept_ra6=//p' "$SYSCTL_STATE" | head -n1)"
  touched6="$(sed -n 's/^ipv6_touched=//p' "$SYSCTL_STATE" | head -n1)"
  [ "$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)" != 1 ] || \
    [ -z "$old4" ] || echo "$old4" > /proc/sys/net/ipv4/ip_forward
  [ "$(cat /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null)" != 1 ] || \
    [ -z "$old6" ] || echo "$old6" > /proc/sys/net/ipv6/conf/all/forwarding
  if [ "$touched6" = 1 ] && [ -n "$wan6" ] && [ -n "$oldra6" ] && \
     [ "$(cat "/proc/sys/net/ipv6/conf/$wan6/accept_ra" 2>/dev/null)" = 2 ]; then
    echo "$oldra6" > "/proc/sys/net/ipv6/conf/$wan6/accept_ra"
  fi
  rm -f "$SYSCTL_STATE"
}

nat_up() {
  [ -n "$OPKGTUN" ] && return 0     # OpkgTun-режим: NAT/firewall делает ndm
  [ "$GATEWAY" = yes ] || return 0
  core_manages_gateway && return 0
  if ! legacy_ipv4_enabled && ! legacy_ipv6_enabled; then
    echo "qeli-client: в $PLAN_STATE нет согласованных IPv4/IPv6 адресов"
    return 1
  fi
  save_forwarding_state || return 1
  if legacy_ipv4_enabled; then
    command -v iptables >/dev/null 2>&1 || {
      echo "qeli-client: согласованный IPv4 legacy gateway требует iptables"; return 1;
    }
    echo 1 > /proc/sys/net/ipv4/ip_forward || return 1
    iptables -t nat -C POSTROUTING -o "$TUN" -j MASQUERADE 2>/dev/null || \
      iptables -t nat -A POSTROUTING -o "$TUN" -j MASQUERADE || return 1
    iptables -C FORWARD -i "$LAN_IF" -o "$TUN" -j ACCEPT 2>/dev/null || \
      iptables -A FORWARD -i "$LAN_IF" -o "$TUN" -j ACCEPT || return 1
    iptables -C FORWARD -i "$TUN" -o "$LAN_IF" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || \
      iptables -A FORWARD -i "$TUN" -o "$LAN_IF" -m state --state RELATED,ESTABLISHED -j ACCEPT || return 1
    iptables -t mangle -C FORWARD -o "$TUN" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || \
      iptables -t mangle -A FORWARD -o "$TUN" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu || return 1
  fi
  if legacy_ipv6_enabled; then
    command -v ip6tables >/dev/null 2>&1 || {
      echo "qeli-client: согласованный IPv6 legacy gateway требует ip6tables"; return 1;
    }
    wan6="$(sed -n 's/^wan6=//p' "$SYSCTL_STATE" | head -n1)"
    if [ -n "$wan6" ] && [ -e "/proc/sys/net/ipv6/conf/$wan6/accept_ra" ]; then
      echo 2 > "/proc/sys/net/ipv6/conf/$wan6/accept_ra" || return 1
    fi
    echo "ipv6_touched=1" >> "$SYSCTL_STATE"
    echo 1 > /proc/sys/net/ipv6/conf/all/forwarding || return 1
    ip6tables -t nat -C POSTROUTING -o "$TUN" -j MASQUERADE 2>/dev/null || \
      ip6tables -t nat -A POSTROUTING -o "$TUN" -j MASQUERADE || return 1
    ip6tables -C FORWARD -i "$LAN_IF" -o "$TUN" -j ACCEPT 2>/dev/null || \
      ip6tables -A FORWARD -i "$LAN_IF" -o "$TUN" -j ACCEPT || return 1
    ip6tables -C FORWARD -i "$TUN" -o "$LAN_IF" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || \
      ip6tables -A FORWARD -i "$TUN" -o "$LAN_IF" -m state --state RELATED,ESTABLISHED -j ACCEPT || return 1
    ip6tables -t mangle -C FORWARD -o "$TUN" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || \
      ip6tables -t mangle -A FORWARD -o "$TUN" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu || return 1
  fi
}

wait_for_network_plan() {
  i=0
  while [ $i -lt 60 ]; do
    [ -s "$PLAN_STATE" ] && return 0
    is_running || return 1
    i=$((i + 1))
    sleep 1
  done
  return 1
}

nat_down() {
  [ -n "$OPKGTUN" ] && return 0     # OpkgTun-режим: NAT/firewall делает ndm
  [ "$GATEWAY" = yes ] || return 0
  # Удаляем и старые внешние правила даже после миграции на gateway_nat=true.
  iptables -t nat -D POSTROUTING -o "$TUN" -j MASQUERADE 2>/dev/null
  iptables -D FORWARD -i "$LAN_IF" -o "$TUN" -j ACCEPT 2>/dev/null
  iptables -D FORWARD -i "$TUN" -o "$LAN_IF" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null
  iptables -t mangle -D FORWARD -o "$TUN" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
  if command -v ip6tables >/dev/null 2>&1; then
    ip6tables -t nat -D POSTROUTING -o "$TUN" -j MASQUERADE 2>/dev/null
    ip6tables -D FORWARD -i "$LAN_IF" -o "$TUN" -j ACCEPT 2>/dev/null
    ip6tables -D FORWARD -i "$TUN" -o "$LAN_IF" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null
    ip6tables -t mangle -D FORWARD -o "$TUN" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
  fi
  restore_forwarding_state
}

is_running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

start() {
  if is_running; then echo "qeli-client уже запущен (pid $(cat "$PIDFILE"))"; return 0; fi
  if [ ! -e /dev/net/tun ]; then
    echo "нет /dev/net/tun — включи компонент VPN в KeeneticOS"; exit 1
  fi
  mkdir -p /opt/var/run /opt/var/log /opt/etc/qeli
  legacy_gateway_preflight || exit 1
  [ -f "$SYSCTL_STATE" ] && nat_down
  rm -f "$PLAN_STATE"
  echo "qeli-client: старт"
  "$BIN" --config "$CONF" >> "$LOG" 2>&1 &
  echo $! > "$PIDFILE"
  if [ -z "$OPKGTUN" ] && [ "$GATEWAY" = yes ] && \
     ! core_manages_gateway && ! wait_for_network_plan; then
    echo "qeli-client: за 60с не получен подтверждённый NetworkPlan"
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE" "$PLAN_STATE"
    exit 1
  fi
  if ! nat_up; then
    echo "qeli-client: не удалось применить legacy gateway firewall"
    nat_down
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE" "$PLAN_STATE"
    exit 1
  fi
  if [ -n "$OPKGTUN" ]; then
    echo "$OPKGTUN" > "$OPKGTUN_STATE"   # сигнал wan.d-хуку: регистрируй OpkgTun в ndm
    echo "qeli-client: OpkgTun-режим ($OPKGTUN) — регистрация в ndm через wan.d-хук"
  fi
}

stop() {
  echo "qeli-client: стоп"
  nat_down
  if [ -f "$PIDFILE" ]; then
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
  fi
  rm -f "$PLAN_STATE"
  if [ -n "$OPKGTUN" ]; then
    rm -f "$OPKGTUN_STATE" "$OPKGTUN_TUNIP"
    # интерфейс из ndm снять вручную из ssh-логина: ndmc -c "no interface OpkgTun0"
    # (tun сам исчезнет при завершении qeli — он non-persistent).
  else
    ip link del "$TUN" 2>/dev/null   # подчистить tun, если остался
  fi
}

case "$1" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; sleep 1; start ;;
  status)  is_running && echo "running (pid $(cat "$PIDFILE"))" || echo "stopped" ;;
  *) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
