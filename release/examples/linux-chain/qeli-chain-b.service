[Unit]
Description=Qeli exit server B
Requires=qeli-chain-b-egress.service
Wants=network-online.target
After=network-online.target qeli-chain-b-egress.service

[Service]
User=root
Environment=STATE_DIRECTORY=/var/lib/qeli-chain/b
Environment=QELI_CONTROL_SOCKET=/var/lib/qeli-chain/b/control.sock
ExecStart=/usr/local/bin/qeli server -c /etc/qeli-chain/b.ini
Restart=always
RestartSec=5
TimeoutStopSec=90
KillMode=control-group

[Install]
WantedBy=multi-user.target
