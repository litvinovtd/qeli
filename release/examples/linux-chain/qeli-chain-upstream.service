[Unit]
Description=Qeli upstream client A to B
Wants=network-online.target qeli-chain-guard.service
After=network-online.target qeli-chain-guard.service

[Service]
User=root
Environment=STATE_DIRECTORY=/var/lib/qeli-chain/upstream
Environment=QELI_KNOWN_HOSTS=/var/lib/qeli-chain/upstream/known-hosts
Environment=QELI_DEVICE_ID_FILE=/var/lib/qeli-chain/upstream/device-id
ExecStart=/usr/local/bin/qeli client -c /etc/qeli-chain/upstream.ini
Restart=always
RestartSec=5
TimeoutStopSec=90
KillMode=control-group

[Install]
WantedBy=multi-user.target
