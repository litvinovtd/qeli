#!/bin/sh /etc/rc.common
# The policy supervisor is independent of the qeli VPN process.
# Reuse the package's private-directory/procd transaction helpers.
. /etc/init.d/qeli

USE_PROCD=1
START=18
STOP=11
EXTRA_COMMANDS="confirm_policy disable_policy"
EXTRA_HELP="
    confirm_policy    Confirm the provisional policy after checking management access
    disable_policy    Return routing/firewall to external ownership"

qeli_router_prepare() {
    local routing firewall policy runtime bootstrap
    config_load qeli || return 1
    config_get routing main router_routing external
    config_get firewall main router_firewall external
    config_get policy main router_policy '{}'
    case "$routing:$firewall" in external:external|external:client|client:external|client:client) ;; *) return 1 ;; esac
    if [ "$routing:$firewall" = external:external ] && {
        [ -L "$STATEDIR/router.owner" ] || [ ! -f "$STATEDIR/router.owner" ] ||
        [ "$(cat "$STATEDIR/router.owner")" != qeli-openwrt-router-v1 ];
    }; then
        return 2
    fi
    [ -x "$BIN" ] || return 1
    ensure_runtime_dir && ensure_state_dir || return 1
    runtime="$(readlink -f "$RUNDIR")" || return 1
    if [ "$firewall" = client ]; then
        [ -x /etc/init.d/qeli-guard ] || return 1
        /etc/init.d/qeli-guard enable || return 1
    fi
    if [ "${1:-}" = bootstrap ]; then bootstrap=--bootstrap; else bootstrap=; fi
    printf '%s' "$policy" | "$BIN" router render --output "$STATEDIR/router.json" \
        --routing "$routing" --firewall "$firewall" --client-config "$CONF" --runtime "$runtime" --openwrt $bootstrap
}

start_service() {
    local result
    QELI_START_RESULT=1
    qeli_track_procd_result
    qeli_router_prepare
    result=$?
    case "$result" in
        0) ;;
        2) QELI_START_RESULT=0; return 0 ;;
        *) QELI_START_RESULT="$result"; return "$result" ;;
    esac
    procd_open_instance policy
    procd_set_param command "$BIN" router run --policy "$STATEDIR/router.json"
    procd_set_param file "$STATEDIR/router.json"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    QELI_START_RESULT=0
}
stop_service() {
    qeli_track_procd_result
    QELI_STOP_RESULT=0
    # Kernel guard remains until explicit external ownership/disable.
}
reload_service() { start; }
service_triggers() { procd_add_reload_trigger qeli; }
confirm_policy() { "$BIN" router confirm --policy "$STATEDIR/router.json"; }
disable_policy() {
    uci set qeli.main.router_routing=external && uci set qeli.main.router_firewall=external && uci commit qeli || return 1
    "$BIN" router disable --policy "$STATEDIR/router.json" || return 1
    start
}
