{
	"luci-app-qeli": {
		"description": "Grant access to the qeli VPN client config and scoped service control",
		"read": {
			"uci": [ "qeli" ],
			"ubus": {
				"service": [ "list" ]
			}
		},
		"write": {
			"uci": [ "qeli" ],
			"ubus": {
				"luci.qeli": [ "service_action", "secret_status", "set_secret", "clear_secret" ]
			}
		}
	}
}
