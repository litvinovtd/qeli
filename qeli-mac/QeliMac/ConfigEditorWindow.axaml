<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:QeliMac"
        x:Class="QeliMac.ConfigEditorWindow"
        Title="{l:Loc Profile}" Width="720" Height="680"
        MinWidth="540" MinHeight="380" CanResize="True"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}">
    <Grid Margin="22" RowDefinitions="Auto,*,Auto">
        <Grid Margin="0,0,0,18" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="HeaderText" Classes="h1" VerticalAlignment="Center"/>
            <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="OnManualEdit" ToolTip.Tip="{l:Loc EditIniHint}" Padding="12,7">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="16" Height="16">
                        <Path Fill="{Binding $parent[Button].Foreground}"
                              Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm2.92 2.33H4.5v-1.42l9.56-9.56 1.42 1.42-9.56 9.56zM20.71 7.04a.996.996 0 0 0 0-1.41l-2.34-2.34a.996.996 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                    </Viewbox>
                    <TextBlock Text="{l:Loc EditIni}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,18,16,16">
                            <TextBlock Text="{l:Loc SectionAccess}" Classes="sectionHeader"/>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{l:Loc FieldName}" Classes="label"/>
                                <TextBox x:Name="NameBox"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,14" ColumnDefinitions="*,14,130">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{l:Loc FieldServer}" Classes="label"/>
                                    <TextBox x:Name="AddrBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:Loc FieldPort}" Classes="label"/>
                                    <TextBox x:Name="PortBox" Text="443"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{l:Loc FieldMode}" Classes="label"/>
                                <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch" SelectionChanged="OnModeChanged">
                                    <ComboBoxItem Content="{l:Loc PresetFakeTls}" Tag="faketls"/>
                                    <ComboBoxItem Content="{l:Loc PresetObfsWs}" Tag="obfs-ws"/>
                                    <ComboBoxItem Content="{l:Loc PresetObfsNone}" Tag="obfs-none"/>
                                    <ComboBoxItem Content="{l:Loc PresetUdp}" Tag="udp"/>
                                    <ComboBoxItem Content="{l:Loc PresetUdpQuic}" Tag="udp-quic"/>
                                    <ComboBoxItem Content="{l:Loc PresetUdpObfs}" Tag="udp-obfs"/>
                                    <ComboBoxItem Content="{l:Loc PresetReality}" Tag="reality-tls"/>
                                    <ComboBoxItem Content="{l:Loc PresetPlain}" Tag="plain"/>
                                </ComboBox>
                            </StackPanel>

                            <Grid Margin="0,0,0,18" ColumnDefinitions="*,14,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{l:Loc FieldLogin}" Classes="label"/>
                                    <TextBox x:Name="UserBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:Loc FieldPassword}" Classes="label"/>
                                    <TextBox x:Name="PassBox" PasswordChar="●"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{l:Loc ConnectionBehavior}" Classes="sectionHeader" Margin="0,12,0,14"/>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{l:Loc FieldTimeout}" Classes="label"/>
                                <AutoCompleteBox x:Name="TimeoutBox" Width="160" HorizontalAlignment="Left"
                                                 MinimumPrefixLength="0" FilterMode="Contains"/>
                            </StackPanel>
                            <CheckBox x:Name="ReconnectBox" Content="{l:Loc ReconnectAutomatically}"
                                      IsCheckedChanged="OnReconnectChanged" Margin="0,0,0,12"/>
                            <StackPanel x:Name="ReconnectPanel" Margin="26,0,0,0">
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{l:Loc ReconnectRetries}" Classes="label"/>
                                    <ComboBox x:Name="ReconnectRetriesBox" Width="220" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="{l:Loc RetriesUnlimited}" Tag="-1"/>
                                        <ComboBoxItem Content="{l:Loc Retries3}" Tag="3"/>
                                        <ComboBoxItem Content="{l:Loc Retries5}" Tag="5"/>
                                        <ComboBoxItem Content="{l:Loc Retries10}" Tag="10"/>
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="PersistTunBox" Content="{l:Loc PersistTun}"/>
                            </StackPanel>
                            <TextBlock Text="{l:Loc SectionTransport}" Classes="sectionHeader" Margin="0,28,0,14"/>
                            <StackPanel x:Name="SniPanel" Margin="0,0,0,14">
                                <TextBlock Text="{l:Loc FieldSni}" Classes="label"/>
                                <AutoCompleteBox x:Name="SniBox" MinimumPrefixLength="0" FilterMode="Contains"
                                                 HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,14" ColumnDefinitions="*,14,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{l:Loc FieldPadding}" Classes="label"/>
                                    <ComboBox x:Name="PaddingBox" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="{l:Loc Off}" Tag="off"/>
                                        <ComboBoxItem Content="{l:Loc PaddingStandard}" Tag="0,255"/>
                                        <ComboBoxItem Content="{l:Loc PaddingStrong}" Tag="40,400"/>
                                        <ComboBoxItem Content="{l:Loc PaddingMax}" Tag="100,800"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:Loc FieldHeartbeat}" Classes="label"/>
                                    <ComboBox x:Name="HeartbeatBox" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="{l:Loc Off}" Tag="off"/>
                                        <ComboBoxItem Content="{l:Loc Hb15}" Tag="15000,2000"/>
                                        <ComboBoxItem Content="{l:Loc Hb30}" Tag="30000,5000"/>
                                        <ComboBoxItem Content="{l:Loc Hb60}" Tag="60000,8000"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14" ColumnDefinitions="*,14,*">
                                <StackPanel x:Name="ObfsKeyPanel" Grid.Column="0">
                                    <TextBlock Text="{l:Loc FieldObfsKey}" Classes="label"/>
                                    <TextBox x:Name="ObfsKeyBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:Loc FieldServerKey}" Classes="label"/>
                                    <TextBox x:Name="KeyBox"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="RealityIdPanel" Margin="0,0,0,14">
                                <TextBlock Text="{l:Loc FieldRealityId}" Classes="label"/>
                                <TextBox x:Name="RealityIdBox"/>
                            </StackPanel>
                            <TextBlock Text="{l:Loc SectionNetwork}" Classes="sectionHeader" Margin="0,14,0,14"/>
                            <Grid Margin="0,0,0,14" ColumnDefinitions="*,14,150">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{l:Loc FieldRouting}" Classes="label"/>
                                    <ComboBox x:Name="RoutingBox" HorizontalAlignment="Stretch" SelectionChanged="OnRoutingChanged">
                                        <ComboBoxItem Content="{l:Loc RouteAll}" Tag="full-tunnel"/>
                                        <ComboBoxItem Content="{l:Loc RouteSplit}" Tag="split-tunnel"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:Loc FieldMtu}" Classes="label"/>
                                    <AutoCompleteBox x:Name="MtuBox" MinimumPrefixLength="0" FilterMode="Contains"
                                                     HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="MtuProbeBox" Content="{l:Loc MtuProbe}" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,8" ColumnDefinitions="190,14,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{l:Loc FieldDnsMode}" Classes="label"/>
                                    <ComboBox x:Name="DnsModeBox" SelectionChanged="OnDnsModeChanged">
                                        <ComboBoxItem Content="{l:Loc DnsTunnel}" Tag="tunnel"/>
                                        <ComboBoxItem Content="{l:Loc DnsSystem}" Tag="system"/>
                                        <ComboBoxItem Content="{l:Loc DnsOff}" Tag="off"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="DnsServersPanel" Grid.Column="2">
                                    <TextBlock Text="{l:Loc FieldDns}" Classes="label"/>
                                    <AutoCompleteBox x:Name="DnsBox" MinimumPrefixLength="0" FilterMode="Contains"
                                                     HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{l:Loc DnsPushHint}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource FgDim}" FontSize="11.5" Margin="0,0,0,16"/>

                            <CheckBox x:Name="LocalBox" Content="{l:Loc RouteLocal}" Margin="0,0,0,12"/>
                            <CheckBox x:Name="KillSwitchBox" Content="{l:Loc KillSwitch}" Margin="0,0,0,18"/>

                            <TextBlock Text="{l:Loc SectionApplications}" Classes="sectionHeader" Margin="0,28,0,14"/>
                            <StackPanel>
                                <TextBlock Text="{l:Loc FieldApps}" Classes="label"/>
                                <ComboBox x:Name="AppsModeBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnAppsModeChanged">
                                    <ComboBoxItem Content="{l:Loc AppsAll}" Tag="all"/>
                                    <ComboBoxItem Content="{l:Loc AppsExclude}" Tag="exclude"/>
                                    <ComboBoxItem Content="{l:Loc AppsInclude}" Tag="include"/>
                                </ComboBox>
                                <TextBox x:Name="AppsBox" Margin="0,8,0,0" AcceptsReturn="True" MinHeight="48"
                                         TextWrapping="Wrap" Watermark="com.apple.Safari, org.mozilla.firefox"/>
                                <Button x:Name="AppsPickBtn" Content="{l:Loc AppsPick}" Click="OnPickApps"
                                        HorizontalAlignment="Left" MinWidth="150" Margin="0,8,0,0"/>
                                <TextBlock x:Name="AppsHintText" Text="{l:Loc AppsMacHint}" Classes="label"
                                           Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.75"/>
                            </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
            <Button Content="{l:Loc Cancel}" Click="OnCancel" MinWidth="104"/>
            <Button Content="{l:Loc Save}" Click="OnSave" Classes="accent" MinWidth="130"/>
        </StackPanel>
    </Grid>
</Window>
