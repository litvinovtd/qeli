<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Log lines must be greppable against the English error catalog in
         docs/*/manuals/TROUBLESHOOTING.md. Framework exception text is otherwise localized to the
         OS language, so a Russian Windows produced logs mixing qeli's own English strings
         with .NET messages like "Удаленный хост принудительно разорвал…" — unsearchable,
         and confusing when a user reports them. Shipping only the English resources keeps
         `e.Message` in one language. The app's OWN ru/en UI is unaffected: it uses the
         hand-written Loc table, not satellite assemblies. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QeliMac</AssemblyName>
    <RootNamespace>QeliMac</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.8.4</Version>
    <QeliNativeCorePath Condition="'$(QeliNativeCorePath)' == ''">$(MSBuildProjectDirectory)/native/libqeli.dylib</QeliNativeCorePath>
    <!-- The runtime identifier is supplied on publish (osx-arm64 / osx-x64). -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Avalonia's compiled-XAML + trimming-friendly settings. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <QeliBuildTools Condition="'$(QeliBuildTools)' == ''">false</QeliBuildTools>
  </PropertyGroup>

  <PropertyGroup Condition="'$(QeliBuildTools)' == 'true'">
    <DefineConstants>$(DefineConstants);QELI_BUILD_TOOLS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(QeliBuildTools)' != 'true'">
    <Compile Remove="UiShot.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Platform-neutral production lifecycle/model adapters. Managed wire conformance
         is built separately by qeli-shared/QeliConformance. -->
    <ProjectReference Include="..\..\qeli-shared\QeliShared\QeliShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-platform XAML UI (the macOS analogue of WPF). 11.3.x for current-macOS
         (Tahoe / macOS 26) Cocoa-backend compatibility. -->
    <!-- 0.11.2 preserves the consumed API and records its exact source commit.
         Later 0.11.x removes protected API; review compatibility before updating. -->
    <PackageReference Include="MicroCom.Runtime" Version="0.11.2" />
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <!-- Diagnostics only in Debug. -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Offscreen rendering for the `uishot` verb (UI screenshots without a display). -->
    <PackageReference Include="Avalonia.Headless" Version="11.3.20" Condition="'$(QeliBuildTools)' == 'true'" />

    <!-- QR generation for profile sharing (pure managed, PNG output). -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- Brand-mark / icon / tray rendering (paths, gradients, text → PNG). The macOS
         native asset ships in the app; the Linux/Win32 ones let the build host run the
         `genicns`/`genassets` verbs (icon rendering) during a cross-build in the lab. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9"
                      Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

  <!-- Native whole-client Rust core (configuration + transport ABI 1.16,
       plus realtls C ABI). A
       universal (arm64+x86_64) dylib cross-built by build_dylib.sh, copied next
       to QeliMac so DllImport("qeli") resolves it inside the .app bundle. The
       Condition lets the project build for dev before the dylib is produced. -->
  <ItemGroup Condition="Exists('$(QeliNativeCorePath)')">
    <Content Include="$(QeliNativeCorePath)">
      <Link>libqeli.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- The common Cargo.lock superset travels with every published client. -->
    <Content Include="..\..\qeli\third-party-notices\rust\**\*">
      <Link>Legal\NativeRust\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- Full reviewed NuGet graphs, runtime pack notices and embedded font licenses. -->
    <Content Include="..\..\qeli-shared\third-party-notices\dotnet\**\*">
      <Link>Legal\DotNet\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\LICENSE">
      <Link>Legal\MPL-2.0.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  <Target Name="RequireManagedLegalBundle" BeforeTargets="PrepareForBuild;ComputeFilesToPublish">
    <Error Condition="!Exists('..\..\qeli-shared\third-party-notices\dotnet\INDEX.tsv')" Text="Missing managed legal bundle; run scripts/managed_licenses.py and review its output." />
  </Target>
  <Target Name="RequireNativeLegalBundle" BeforeTargets="PrepareForBuild;ComputeFilesToPublish">
    <Error Condition="!Exists('..\..\qeli\third-party-notices\rust\INDEX.tsv')" Text="Missing native legal bundle; run scripts/native_licenses.py and review its output." />
  </Target>
</Project>
