{
  "base": "[qeli]\nuser = audit\npass = audit\nroaming = off\nallow_unpinned_tofu = true\n",
  "cases": [
    {
      "name": "persistent Windows adapter local policy",
      "ini": "server = vpn.example:443\nwindows_persistent_adapter = true\n",
      "valid": true
    },
    {
      "name": "persistent Windows adapter rejects an ambiguous value",
      "ini": "server = vpn.example:443\nwindows_persistent_adapter = auto\n",
      "valid": false
    },
    {
      "name": "explicit compact REALITY policy",
      "ini": "server = 192.0.2.1:443\nmode = reality-tls\nkey = 0a33d308295d5dc49bff020ca8a73e86b3f6797cbcc7d3aa440eee754729223a\nreality_sid = 0123456789abcdef\nsni = decoy.example\nreality_compact = true\nreality_split = none\nreality_split_delay = 0\n",
      "valid": true
    },
    {
      "name": "PQ REALITY with explicit split",
      "ini": "server = 192.0.2.1:443\nmode = reality-tls\nkey = 0a33d308295d5dc49bff020ca8a73e86b3f6797cbcc7d3aa440eee754729223a\nreality_sid = 0123456789abcdef\nsni = decoy.example\nreality_compact = false\nreality_split = sni\nreality_split_delay = 100\n",
      "valid": true
    },
    {
      "name": "compact requires explicit boolean",
      "ini": "server = vpn.example:443\nreality_compact = auto\n",
      "valid": false
    },
    {
      "name": "WebSocket endpoint Host without inherited TLS name",
      "ini": "server = 192.0.2.1:443\nmode = obfs\nfront = websocket\nobfs_key = secret\n",
      "valid": true
    },
    {
      "name": "WebSocket explicit IPv6 Host",
      "ini": "server = 192.0.2.1:443\nmode = obfs\nfront = websocket\nobfs_key = secret\nsni = 2001:db8::5\n",
      "valid": true
    },
    {
      "name": "unsigned negative zero",
      "ini": "server = 127.0.0.1:443\nrecv_buffer_size = -0\n",
      "valid": false
    },
    {
      "name": "recv negative",
      "ini": "server = 127.0.0.1:443\nrecv_buffer_size = -1\n",
      "valid": false
    },
    {
      "name": "recv over limit",
      "ini": "server = 127.0.0.1:443\nrecv_buffer_size = 67108865\n",
      "valid": false
    },
    {
      "name": "send negative",
      "ini": "server = 127.0.0.1:443\nsend_buffer_size = -1\n",
      "valid": false
    },
    {
      "name": "send over limit",
      "ini": "server = 127.0.0.1:443\nsend_buffer_size = 67108865\n",
      "valid": false
    },
    {
      "name": "local shorthand",
      "ini": "server = 127.0.0.1:443\nlocal = 127.1\n",
      "valid": false
    },
    {
      "name": "local scope",
      "ini": "server = 127.0.0.1:443\nlocal = fe80::1%3\n",
      "valid": false
    },
    {
      "name": "route leading zero",
      "ini": "server = 127.0.0.1:443\ninclude = 010.0.0.1/8\n",
      "valid": false
    },
    {
      "name": "route scope",
      "ini": "server = 127.0.0.1:443\ninclude = fe80::1%3/64\n",
      "valid": false
    },
    {
      "name": "zero buffers",
      "ini": "server = 127.0.0.1:443\nrecv_buffer_size = 0\nsend_buffer_size = 0\n",
      "valid": true
    },
    {
      "name": "maximum buffers",
      "ini": "server = 127.0.0.1:443\nrecv_buffer_size = 67108864\nsend_buffer_size = 67108864\n",
      "valid": true
    },
    {
      "name": "local IPv6",
      "ini": "server = 127.0.0.1:443\nlocal = ::1\n",
      "valid": true
    },
    {
      "name": "route IPv6",
      "ini": "server = 127.0.0.1:443\ninclude = 2001:db8::/64\n",
      "valid": true
    },
    {
      "name": "server scope",
      "ini": "server = [fe80::1%3]:443\n",
      "valid": false
    },
    {
      "name": "server IPv6",
      "ini": "server = [::1]:443\n",
      "valid": true
    },
    {
      "name": "decline pushed routes",
      "ini": "server = 127.0.0.1:443\npull_routes = false\n",
      "valid": true
    },
    {
      "name": "invalid pull_routes boolean",
      "ini": "server = 127.0.0.1:443\npull_routes = maybe\n",
      "valid": false
    },
    {
      "name": "legacy unused UDP obfs SNI",
      "ini": "server = 127.0.0.1:443\nproto = udp\nmode = obfs\nobfs_key = secret\nsni = !\n",
      "valid": true
    },
    {
      "name": "reject invalid WebSocket Host",
      "ini": "server = 127.0.0.1:443\nmode = obfs\nfront = websocket\nobfs_key = secret\nsni = !\n",
      "valid": false
    }
  ]
}
